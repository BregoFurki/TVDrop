<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/card_tv_selector"
    android:descendantFocusability="afterDescendants"
    android:focusable="false"
    android:gravity="center_vertical"
    android:minHeight="82dp"
    android:orientation="horizontal"
    android:paddingStart="13dp"
    android:paddingTop="11dp"
    android:paddingEnd="13dp"
    android:paddingBottom="11dp">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/file_icon_surface"
        android:contentDescription="@null"
        android:padding="7dp"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            tools:text="SmartTube_v21.apk" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="v21.40 • 24.5 MB" />

        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/accent_emerald"
            android:textSize="10sp"
            tools:text="İndirilenler / TVDrop" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnInstall"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/btn_tv_selector"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:focusable="true"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:text="@string/btn_install_apk"
            android:textAllCaps="false"
            android:textColor="@color/btn_tv_text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnOpen"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/btn_tv_selector"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/btn_open_file"
            android:textAllCaps="false"
            android:textColor="@color/btn_tv_text"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/btn_tv_selector"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/btn_delete_file"
            android:textAllCaps="false"
            android:textColor="@color/btn_tv_delete_text"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
